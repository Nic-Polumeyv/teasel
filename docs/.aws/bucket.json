{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "AllowCloudFrontServicePrincipalReadOnly",
			"Effect": "Allow",
			"Principal": { "Service": "cloudfront.amazonaws.com" },
			"Action": ["s3:GetObject", "s3:ListBucket"],
			"Resource": ["arn:aws:s3:::teasel.dev", "arn:aws:s3:::teasel.dev/*"],
			"Condition": {
				"StringEquals": { "AWS:SourceArn": "arn:aws:cloudfront::038462749233:distribution/E2MJUFV76BN8VA" }
			}
		}
	]
}
