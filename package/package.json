{
	"name": "@teasel/parser",
	"version": "0.0.6",
	"description": "A JavaScript and TypeScript parser in Rust. It answers in ESTree.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Nic-Polumeyv/teasel.git"
	},
	"type": "module",
	"main": "index.js",
	"types": "index.d.ts",
	"exports": {
		".": {
			"node": {
				"types": "./index.d.ts",
				"default": "./index.js"
			},
			"default": {
				"types": "./wasm.d.ts",
				"default": "./wasm.js"
			}
		},
		"./wasm": {
			"types": "./wasm.d.ts",
			"default": "./wasm.js"
		},
		"./teasel.wasm": "./teasel.wasm",
		"./plan": {
			"types": "./plan.d.ts",
			"default": "./plan.js"
		}
	},
	"files": [
		"index.js",
		"index.d.ts",
		"wasm.js",
		"wasm.d.ts",
		"native.js",
		"api.js",
		"decode.js",
		"identifier.js",
		"plan.js",
		"plan.d.ts",
		"teasel.wasm"
	],
	"scripts": {
		"build": "bun run build:plan && bun addon.js",
		"build:plan": "tsc --ignoreConfig plan.ts --declaration --strict --target es2022 --module esnext --moduleResolution bundler --skipLibCheck",
		"build:wasm": "cargo build --release -p teasel-wasm --target wasm32-unknown-unknown && cp ../target/wasm32-unknown-unknown/release/teasel_wasm.wasm teasel.wasm",
		"test": "bun test.js && bun test.js interpret",
		"types": "tsc -p tsconfig.json",
		"check": "node check.js",
		"prepublishOnly": "bun run build:plan",
		"changeset:version": "changeset version && bun versions.js && git add --all"
	},
	"dependencies": {
		"@types/estree": "^1.0.6"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.1",
		"@types/bun": "^1.4.2",
		"typescript": "^7.0.2"
	}
}
