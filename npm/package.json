{
	"name": "@teasel/parser",
	"version": "0.0.17",
	"description": "A JavaScript and TypeScript parser in Rust. It answers in ESTree.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Nic-Polumeyv/teasel.git"
	},
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./grammar": "./dist/grammar.js",
		"./teasel.wasm": "./dist/teasel.wasm"
	},
	"imports": {
		"#engine": {
			"node-addons": "./dist/engine/native.js",
			"default": "./dist/engine/wasm.js"
		}
	},
	"files": [
		"dist",
		"!dist/*.node"
	],
	"scripts": {
		"build": "npm run build:js && node scripts/addon.ts",
		"build:js": "tsc -p tsconfig.build.json",
		"build:wasm": "cargo build --release -p teasel-wasm --target wasm32-unknown-unknown && node scripts/wasm.ts",
		"test": "npm run build:js && node scripts/test.ts && node --no-addons scripts/test.ts && node --no-addons scripts/test.ts interpret",
		"types": "tsc -p tsconfig.json",
		"check": "npm run build:js && node scripts/check.ts",
		"prepublishOnly": "npm run build:js"
	},
	"dependencies": {
		"@types/estree": "^1.0.6"
	},
	"devDependencies": {
		"@types/node": "^26.0.0",
		"typescript": "7.0.2"
	}
}
