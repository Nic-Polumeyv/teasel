{
	"name": "@teasel/parser",
	"version": "0.0.10",
	"description": "A JavaScript and TypeScript parser in Rust. It answers in ESTree.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Nic-Polumeyv/teasel.git"
	},
	"type": "module",
	"engines": {
		"node": ">=18"
	},
	"main": "node.js",
	"types": "types.d.ts",
	"exports": {
		".": {
			"node": {
				"types": "./types.d.ts",
				"default": "./node.js"
			},
			"default": {
				"types": "./types.d.ts",
				"default": "./wasm.js"
			}
		},
		"./wasm": {
			"types": "./types.d.ts",
			"default": "./wasm.js"
		},
		"./teasel.wasm": "./teasel.wasm",
		"./plan": {
			"types": "./plan.d.ts",
			"default": "./plan.js"
		}
	},
	"files": [
		"node.js",
		"wasm.js",
		"types.d.ts",
		"plan.js",
		"plan.d.ts",
		"teasel.wasm",
		"lib/"
	],
	"scripts": {
		"build": "npm run build:plan && node scripts/addon.js",
		"build:plan": "tsc --ignoreConfig plan.ts --declaration --strict --target es2022 --module esnext --moduleResolution bundler --skipLibCheck",
		"build:wasm": "cargo build --release -p teasel-wasm --target wasm32-unknown-unknown && wasm-opt -Oz --all-features ../target/wasm32-unknown-unknown/release/teasel_wasm.wasm -o teasel.wasm",
		"test": "node scripts/test.js && node scripts/test.js interpret",
		"types": "tsc -p tsconfig.json",
		"check": "node scripts/check.js",
		"prepublishOnly": "npm run build:plan"
	},
	"dependencies": {
		"@types/estree": "^1.0.6"
	},
	"devDependencies": {
		"@types/node": "^26.0.0"
	}
}
