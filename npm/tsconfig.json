{
	"compilerOptions": {
		"strict": true,
		"target": "es2022",
		"module": "nodenext",
		"lib": ["es2022", "dom", "esnext.disposable"],
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["node"],
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"rewriteRelativeImportExtensions": true
	},
	"include": ["src/**/*.ts", "scripts/**/*.ts"],
	"exclude": ["dist"]
}
