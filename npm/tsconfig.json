{
	"compilerOptions": {
		"strict": true,
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2022", "dom"],
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["node"],
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true
	},
	"include": ["*.ts", "lib/*.ts", "scripts/*.ts", "../crates/teasel/tests/hosts/**/*.mts"],
	"exclude": ["dist"]
}
