{
	"name": "@teasel/parser",
	"version": "0.0.0",
	"description": "A JavaScript and TypeScript parser in Rust, with acorn's ESTree output",
	"license": "MIT",
	"repository": "github:Nic-Polumeyv/teasel",
	"type": "module",
	"main": "index.js",
	"types": "index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		}
	},
	"files": ["index.js", "index.d.ts", "identifier.js", "decode.js", "binding.cjs", "binding.d.ts", "*.node"],
	"napi": {
		"binaryName": "teasel",
		"targets": ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu", "x86_64-apple-darwin", "aarch64-apple-darwin", "x86_64-pc-windows-msvc"]
	},
	"scripts": {
		"build": "napi build --platform --release --js binding.cjs --dts binding.d.ts",
		"test": "bun test.js"
	},
	"dependencies": {
		"@types/estree": "^1.0.6"
	},
	"devDependencies": {
		"@napi-rs/cli": "^3.9.0"
	}
}
